# ==============================================================================
# AI ALGORITHMIC TRADING & BESS ARBITRAGE OPTIMIZER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Rust Backend Control Plane
RUST_HOST=127.0.0.1
RUST_PORT=8230
RUST_LOG=backend=info,tower_http=info

# Internal Python Machine Learning Service (XGBoost & PyTorch PPO)
ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_PORT=8231
ML_SERVICE_URL=http://127.0.0.1:8231

# Frontend Vite Dev Server
FRONTEND_PORT=3230

# Database Persistence
# Default: SQLite with WAL mode (Zero external daemon dependency)
DATABASE_URL=sqlite://bess_optimizer.db?mode=rwc

# Optional TimescaleDB / PostgreSQL (if external service is configured)
# DATABASE_URL=postgres://bess_user:secure_password@127.0.0.1:55452/bess_market

# Market Dataset Path
DATASET_PATH=data/datasets/caiso_hourly_benchmark_2024.csv

# Risk Controls & Safety
EMERGENCY_KILL_SWITCH_DEFAULT=false
LIVE_TRADING_LOCKED=true
